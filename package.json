{
  "name": "wordmemo",
  "version": "0.5.1",
  "description": "WordMemo - 英语笔记背诵工具",
  "main": "./out/main/index.js",
  "author": "ymh",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview --noSandbox",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "ai-smoke": "node scripts/ai-smoke.mjs",
    "dist": "node scripts/make-portable.mjs",
    "dist:app": "electron-vite build && electron-builder --win --x64 --dir",
    "launcher": "node scripts/build-launcher.mjs",
    "icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "chardet": "^2.1.0",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-fsrs": "^6.0.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.ymh.wordmemo",
    "productName": "WordMemo",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "WordMemo-${version}-app.${ext}"
    }
  }
}
